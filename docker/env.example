# Plantilla del .env para el entorno Docker de desarrollo.
#
# En una maquina nueva:   cp docker/env.example .env
#
# OJO: el example.env de la raiz es el del proyecto original y apunta a
# localhost/root/smtp.gmail.com: NO funciona con docker compose.
# Los nombres 'db' y 'mail' son los servicios de docker-compose.yml.
#
# MAIL_ENCRYPTION no puede quedar vacio: Swiftmailer lo usa tal cual para
# construir la URL del socket. Para SMTP sin cifrar, el valor es 'tcp'.
#
# El panel de ajustes reescribe este fichero y pierde los comentarios.

DB_SERVER=db
DB_USERNAME=gymone
DB_PASSWORD=gymone
DB_NAME=gymone
BUSINESS_NAME=Gimnasio Demo
META_KEY=gimnasio, fitness
DESCRIPTION=Gimnasio de pruebas.
LANG_CODE=ES
CURRENCY=EUR
COUNTRY=Espana
CITY=Madrid
STREET=Calle Mayor
HOUSE_NUMBER=14
PHONE_NO=+34600000000
APP_VERSION=V1.4.1
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=demo@gimnasiodemo.local
MAIL_PASSWORD=
MAIL_ENCRYPTION=tcp
GOOGLE_KEY=
CAPACITY=20
ABOUT=Gimnasio de demostracion.
AUTOACCEPT=FALSE
